# Basura de macOS - CRITICO
# Pegasus escanea por extension: "._mok.zip" termina en .zip y te aparece
# como juego fantasma en la coleccion.
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
desktop.ini

# La libreria real no va al repo (ROMs pesadas, CHDs de 132MB, assets)
library/**
!library/.gitkeep

# Binarios instalados: Pegasus.app + una distribucion completa de MAME, 513M.
# Mismo criterio que library/ - pesa y no aporta, se instala, no se versiona.
# OJO: mame0286-x86/ ahi adentro es 0.286, y ADR-0005 exige 0.288+ e IDENTICA
# en las dos maquinas. Ver README.md #Runtime.
pegasus/

# Artefactos de build: metadata.pegasus.txt lo genera ATTRACT (ver ADR-0002)
# Excepcion: los de fixtures/ y docs/ NO son artefactos, son entradas de test
# escritas a mano. Sin ellos "make doctor" no tiene nada que masticar en un
# clon limpio.
build/
*.pegasus.txt
!docs/**/*.pegasus.txt
!fixtures/**/*.pegasus.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Config local de Claude Code (la compartida, .claude/settings.json, SI va)
.claude/settings.local.json

# Los paquetes COINDOOR son entrada, no fuente: traen el video del juego y
# pesan entre 1 y 23 MB cada uno. Mismo criterio que library/. La excepcion es
# ghost-n-goblins, que ya estaba versionado como paquete de prueba de
# `attract import`. Si hace falta uno nuevo para un test, pesalo antes.
files_install/*.zip
!files_install/ghost-n-goblins.coindoor.zip

# El prototipo del handoff de diseno es byte a byte IDENTICO a
# docs/mockup-referencia.html, que ya esta versionado. Commitear los dos son
# 87K duplicados que se desincronizan a la primera. El README.md de esa
# carpeta SI va: es el handoff escrito, no esta en ningun otro lado.
design_handoff_game_detail/*.html
